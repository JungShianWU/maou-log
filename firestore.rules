rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 可編輯的帳號：要開放給別人時把 uid 加進來，並同步修改 firebase-config.js 的 EDITOR_UIDS
    function isEditor() {
      return request.auth != null && request.auth.uid in ['F6SSiFKOSzSMDPS91GGHJICiHUg2'];
    }
    function isText(v, max) {
      return v is string && v.size() <= max;
    }
    function isBossRef(v) {
      return v is string && v.size() >= 1 && v.size() <= 40;
    }
    function isHHMM(v) {
      return v is string && v.matches('^[0-9]{2}:[0-9]{2}$');
    }

    // 公開看板：任何人都能看（不用登入），只有編輯者能改
    match /boards/{board} {
      allow read: if true;
      allow delete: if isEditor();
      allow create, update: if isEditor() && board == 'main'
        && request.resource.data.keys().hasOnly(['templates', 'overrides'])
        && request.resource.data.get('templates', {}) is map
        && request.resource.data.get('overrides', {}) is map;

      match /bosses/{id} {
        allow read: if true;
        allow delete: if isEditor();
        allow create, update: if isEditor() && board == 'main'
          && request.resource.data.keys().hasOnly(['level', 'name', 'note', 'by'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.level is int
          && request.resource.data.level >= 1 && request.resource.data.level <= 999
          && isText(request.resource.data.name, 20) && request.resource.data.name.size() >= 1
          && isText(request.resource.data.note, 200);
      }

      match /events/{id} {
        allow read: if true;
        allow delete: if isEditor();
        allow create, update: if isEditor() && board == 'main'
          && request.resource.data.keys().hasOnly(['boss', 'at', 'status', 'note', 'by'])
          && isBossRef(request.resource.data.boss)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is number
          && request.resource.data.status in ['work', 'remote', 'makeup', 'lunch', 'away', 'back', 'nap', 'off']
          && isText(request.resource.data.note, 100);
      }

      match /leaves/{id} {
        allow read: if true;
        allow delete: if isEditor();
        allow create, update: if isEditor() && board == 'main'
          && request.resource.data.keys().hasOnly(['boss', 'date', 'kind', 'type', 'note', 'start', 'end', 'by'])
          && isBossRef(request.resource.data.boss)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.kind in ['full', 'am', 'pm', 'custom']
          && isText(request.resource.data.type, 30)
          && isText(request.resource.data.note, 100)
          && (request.resource.data.kind != 'custom'
              || (isHHMM(request.resource.data.start) && isHHMM(request.resource.data.end)));
      }
    }
  }
}

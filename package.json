{
  "name": "maou-log",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 5288 --bind localhost",
    "test": "TZ=America/Los_Angeles node --test rules.test.js version.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project maou-log-jt2c4 \"node --test tests/firestore-rules.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,database --project maou-log-jt2c4 \"playwright test\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "firebase": "^13.4.0"
  }
}
